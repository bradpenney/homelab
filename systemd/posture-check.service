[Unit]
Description=Assert the k0s cluster's security invariants still hold
Documentation=file:///home/brad/notes/adr_register.md
# Same pattern as nextcloud-backup: a failure fires a notification rather than
# sitting silently in the journal. Every control on this cluster is preventive;
# this unit is the only thing that NOTICES when one stops being true.
OnFailure=posture-check-notify.service publish-status.service
# The site shows this run (ADR-194) whichever way it went: a run with findings
# is exactly the run the public should see. publish-status is its own unit so
# a Cloudflare problem is a publish failure, never a "security invariant broke".
OnSuccess=publish-status.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=brad
# Runs as the scoped read-only identity, never break-glass (ADR-071).
Environment=POSTURE_CONTEXT=brad
#
# SELINUX GOVERNS BOTH LINES BELOW. Fedora labels everything under
# /home/linuxbrew as user_home_t, and a systemd service may not execute a
# user_home_t binary -- it fails with 203/EXEC "Permission denied" on a file
# that exists and that `brad` can run fine from a shell. Anything this unit
# executes must therefore resolve to a system path (bin_t).
#
# So: NO linuxbrew on PATH. /usr/local/bin/kubectl is bin_t, and at v1.36.1 is
# also closer to the cluster (v1.36.3) than linuxbrew's v1.35.1.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# A static musl binary in a bin_t path. Nothing under /home is executed
# any more: no venv, no linuxbrew python, no RPM pydantic. The repo path is
# only READ (site.yml, versions.yml).
# --record writes the run as the published document, pass or fail, for
# publish-status.service (OnSuccess/OnFailure above) to send.
ExecStart=/usr/local/bin/substrate posture-check --repo /home/brad/notes/source_code/substrate --record /var/lib/substrate/posture.json
TimeoutStartSec=300
