[Unit]
Description=Nextcloud encrypted backup to Google Drive
After=network-online.target docker.service
Wants=network-online.target
OnFailure=nextcloud-backup-notify.service

[Service]
Type=oneshot
# Creates /var/lib/homelab, where backup.sh writes its success stamp. The stamp
# has to outlive a reboot, so it cannot go in /run -- see backup-heartbeat.sh.
StateDirectory=homelab
ExecStart=/bin/bash /home/brad/homelab/backup.sh
StandardOutput=journal
StandardError=journal
