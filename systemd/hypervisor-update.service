[Unit]
# Added 2026-08-27. This unit failed five nights running -- the host applied no
# updates and never rebooted -- and nothing said so, because there was no
# OnFailure here at all. The failure was found by reading the journal for an
# unrelated reason.
OnFailure=hypervisor-update-notify.service
Description=Nightly hypervisor updates (reboots only when required and safe)
Documentation=https://github.com/bradpenney/homelab-infra
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=oneshot
# PEER_HOST and KUBECONFIG_PATH come from here; written per-host by
# deploy-updates.sh since each hypervisor's peer is the other one.
EnvironmentFile=/etc/homelab/update.env
ExecStart=/usr/local/bin/hypervisor-update.sh
# Updates + drain + guest shutdown grace can legitimately take a while.
TimeoutStartSec=3600

