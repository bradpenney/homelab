.env
.venv/
# traefik-data holds acme.json — the Let's Encrypt ACCOUNT KEY and the private
# key of every certificate this Traefik has issued. Never commit it.
#
# dynamic/ is configuration rather than key material, and one file in it is a
# security control (the Cloudflare-only origin lock, ADR-070). It is still NOT
# committed, deliberately: this repository is PUBLIC, and that file describes the
# ingress topology — which host fronts the cluster, on which LAN address, and
# which hostnames are proxied. That is the same class of detail deliberately kept
# out of `substrate` via site.yml.
#
# It is protected by BACKUP instead of by git — see backup.sh, which syncs
# traefik-data/dynamic to the encrypted remote. Losing it would silently reopen
# the public bypass, so it must be recoverable even though it is not in version
# control.
traefik-data/

# Timestamped .bak files from in-place edits. Git is the backup; a public repo
# does not need six copies of an old script.
#
# ⚠️ THESE TWO PATTERNS HAD A HOLE, FOUND 2026-09-09.
# `*.bak` matches only names ENDING in .bak, and `*.bak-*` needs a DASH. A file
# named `.env.bak.2026-09-07` — a dot, not a dash — matched NEITHER, and it sat
# untracked in this PUBLIC repository holding 14 credential lines. Nothing had
# been committed (checked: only .env.example is in history), but a single
# `git add -A` would have published every secret this stack uses.
#
# The `.env.*` rule below is the real fix: the patterns above are shape-matching
# on a filename, and the thing worth protecting is the .env prefix.
*.bak
*.bak-*
*.bak.*

# Every variant of the environment file, however it is suffixed or dated.
# .env.example is the deliberate exception — it is the documented template and
# carries no values.
.env.*
!.env.example

# Migration working copies. `migrate_wanderer.sh` and `migrate_donetick.sh` both
# write a timestamped directory holding a full database snapshot and the
# before/after row counts, and they are kept ON PURPOSE as rollback material.
# They are real user data and must never be committed to a public repo.
*-migration-*/
*-migration-*.db
nextcloud-data/
nextcloud-config/
nextcloud-db/
hass-config/
wanderer-db/
wanderer-search/
wanderer-uploads/
.garmin-tokens/
garmin-sync-state.json
donetick-data/
donetick-config/

# staged kubeconfig — contains a client cert; install to /etc/homelab and delete
hypervisor-kubeconfig.new

# gh writes here if HOME is unset; not a credential, but machine-identifying
.local/
